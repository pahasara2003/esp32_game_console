#include "game.h"
#include "cave_preview.h"
#include "crystal_cave_world.h"

namespace {
constexpr int VIEW_W = 240;
constexpr int VIEW_H = 320;
constexpr int PAN_X = 32;
constexpr int PAN_Y = 24;
int scrollX = 0;
int scrollY = 0;

void drawWorldRow(int screenY, int worldY, int x0) {
  uint16_t line[VIEW_W];
  uint32_t pos = pgm_read_dword(&crystal_world_rows[worldY]);
  uint32_t end = pgm_read_dword(&crystal_world_rows[worldY + 1]);
  int worldX = 0;
  int out = 0;
  while (pos < end && out < VIEW_W) {
    uint8_t run = pgm_read_byte(&crystal_world_data[pos++]);
    uint8_t index = pgm_read_byte(&crystal_world_data[pos++]);
    int nextX = worldX + run;
    int from = max(worldX, x0);
    int to = min(nextX, x0 + VIEW_W);
    for (int x = from; x < to; ++x)
      line[x - x0] = pgm_read_word(&crystal_world_palette[index]);
    worldX = nextX;
  }
  tft.pushImage(0, screenY, VIEW_W, 1, line);
}

void drawCrystalViewport() {
  tft.setSwapBytes(true);
  for (int y = 0; y < VIEW_H; ++y)
    drawWorldRow(y, scrollY + y, scrollX);
  tft.setSwapBytes(false);

  // Small navigation chrome keeps the scene visible while explaining the demo.
  tft.fillRect(0, 0, VIEW_W, 18, 0x100F);
  tft.setTextDatum(TL_DATUM);
  tft.setTextFont(1);
  tft.setTextColor(0xFFFF, 0x100F);
  tft.drawString("CRYSTAL CAVES", 8, 4);
  tft.setTextDatum(TR_DATUM);
  tft.setTextColor(0xBDF7, 0x100F);
  tft.drawString("ARROWS PAN", 232, 4);
}
}

void showCrystalCavePreview() {
  tft.setRotation(2);
  buttonsRequireRelease();
  scrollX = 0;
  scrollY = 0;
  drawCrystalViewport();

  for (;;) {
    int command = findCommand(false);
    if (Serial.available()) {
      char c = Serial.read();
      if (c == 'w' || c == 'W') command = 0;
      else if (c == 'd' || c == 'D') command = 1;
      else if (c == 's' || c == 'S') command = 2;
      else if (c == 'a' || c == 'A') command = 3;
      else if (c == 'e' || c == 'E' || c == ' ' || c == '\n') command = 4;
    }
    int nextX = scrollX;
    int nextY = scrollY;
    if (command == 0) nextY -= PAN_Y;
    else if (command == 1) nextX += PAN_X;
    else if (command == 2) nextY += PAN_Y;
    else if (command == 3) nextX -= PAN_X;
    else if (command == 4) break;
    nextX = constrain(nextX, 0, (int)CRYSTAL_WORLD_W - VIEW_W);
    nextY = constrain(nextY, 0, (int)CRYSTAL_WORLD_H - VIEW_H);
    if (nextX != scrollX || nextY != scrollY) {
      scrollX = nextX;
      scrollY = nextY;
      drawCrystalViewport();
    }
    delay(2);
  }
  buttonsRequireRelease();
}
