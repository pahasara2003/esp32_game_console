      char sc = Serial.read();
      if (sc == ' ' || sc == 'x' || sc == 'e') c = 4;
      else if (sc == 'w') c = 0;
      else if (sc == 's') c = 2;
      else if (sc == 'a' || sc == 'q') c = 3;
    }
    
    // Exit back to menu on LEFT (command 3)
    if (c == 3) {
      setBuzzerTone(0);
      playNavClick();
      break;
    }

    if (c == 0) { // UP
      setBuzzerTone(0);
      isPlaying = false;
      currentSong = (currentSong - 1 + JUKEBOX_COUNT) % JUKEBOX_COUNT;
      playNavClick();
      drawJukeboxUI();
      delay(150);
    } else if (c == 2) { // DOWN
      setBuzzerTone(0);
      isPlaying = false;
      currentSong = (currentSong + 1) % JUKEBOX_COUNT;
      playNavClick();
      drawJukeboxUI();
      delay(150);
    } else if (c == 4) { // SHOOT: Play / Stop
      if (isPlaying) {
        setBuzzerTone(0);
        isPlaying = false;
        drawJukeboxUI();
        delay(200);
      } else {
        isPlaying = true;
        drawJukeboxUI();
        
        // Play selected track with interactive abort on any button press
        const Track& trk = jukeboxPlaylist[currentSong];
        for (int i = 0; i < trk.noteCount; i++) {
          // Check for button press to stop or change song
          int interruptCmd = findCommand(false);
          if (interruptCmd == 4 || interruptCmd == 0 || interruptCmd == 2 || interruptCmd == 3) {
            setBuzzerTone(0);
            isPlaying = false;
            break;
          }
          if (Serial.available()) {
            Serial.read();
            setBuzzerTone(0);
            isPlaying = false;
            break;
          }
          
          uint16_t freq = trk.notes[i].freq;
          uint16_t dur = trk.notes[i].duration;
          
          if (freq > 0) {
            setBuzzerTone(freq);
          } else {
            setBuzzerTone(0);
          }
          
          // Mini visualizer bar in card
          int barW = map(freq, 200, 900, 10, 180);
          barW = constrain(barW, 10, 180);
          tft.fillRect(30, 240, 180, 4, UI_PANEL);
          if (freq > 0) {
            tft.fillRect(30, 240, barW, 4, MENU_ACCENT_DIM);
          }
          
          delay(dur);
          setBuzzerTone(0);
          delay(20);
        }
        
        setBuzzerTone(0);
        isPlaying = false;
        drawJukeboxUI();
      }
    }
    delay(20);
  }
  
  setBuzzerTone(0);
  menuSetup();
}

static int readSettingsCommand() {
  int cmd = findCommand(false);
  if (Serial.available()) {
    char c = Serial.read();
    if (c == 'w' || c == 'W') cmd = 0;
    else if (c == 'd' || c == 'D') cmd = 1;
    else if (c == 's' || c == 'S') cmd = 2;
    else if (c == 'a' || c == 'A') cmd = 3;
    else if (c == ' ' || c == '\n' || c == '\r' || c == 'e' || c == 'E' || c == 'x' || c == 'X') cmd = 4;
  }
  return cmd;
}


