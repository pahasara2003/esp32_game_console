static bool confirmResetScores() {
  int choice = 0;
  drawResetScoresConfirmation(choice);
  buttonsRequireRelease();
  while (true) {
    int cmd = readSettingsCommand();
    if (cmd >= 0 && cmd <= 3) {
      choice = 1 - choice;
      playNavClick();
      drawResetScoresConfirmation(choice);
    } else if (cmd == 4) {
      playSelectTone();
      buttonsRequireRelease();
      return choice == 1;
    }
    delay(12);
  }
}

void showSettingsScreen() {
  int selectedRow = 0;
  drawSettingsScreen(selectedRow);
  delay(220);

  while (true) {
    int cmd = readSettingsCommand();

    if (cmd == 0 || cmd == 2) {
      int previousRow = selectedRow;
      selectedRow = (selectedRow + (cmd == 0 ? 2 : 1)) % 3;
      playNavClick();
      drawSettingsRow(previousRow, false);
      drawSettingsRow(selectedRow, true);
    } else if (cmd == 1 || cmd == 3) {
      if (selectedRow == 0) {
        int direction = (cmd == 1) ? 1 : -1;
        applyThemePreset((activeTheme + direction + THEME_COUNT) % THEME_COUNT, false);
        playNavClick();
        refreshSettingsTheme(selectedRow);
      } else if (selectedRow == 1) {
        setSoundEnabled(!soundEnabled, false);
        playNavClick();
        drawSettingsRow(selectedRow, true);
      }
    } else if (cmd == 4) {
      if (selectedRow == 2) {
        if (confirmResetScores()) {
          resetAllGameScores();
          tft.fillScreen(UI_BG);
          tft.setTextDatum(MC_DATUM);
          tft.setTextFont(2);
          tft.setTextColor(UI_GREEN, UI_BG);
          tft.drawString("SCORES RESET", 120, 154);
          delay(650);
        }
        drawSettingsScreen(selectedRow);
      } else {
        applyThemePreset(activeTheme, true);
        setSoundEnabled(soundEnabled, true);
        playSelectTone();
        menuSetup();
        return;
      }
    }
    delay(16);
  }
}

